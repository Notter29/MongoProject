# Puerto y Host del Backend
PORT=3000
HOST=0.0.0.0

# Conexión a MongoDB (Modo Replica Set obligatorio para Change Streams)
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=ecommerce_analytics
COLLECTION_NAME=eventos

# Proveedor de Inteligencia Artificial ('gemini' o 'ollama')
AI_PROVIDER=gemini

# Configuración Google Gemini REST API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Configuración Ollama Local (100% Offline / Open Source)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:7b
